{
    "openapi": "3.0.0",
    "info": {
        "title": "Geo API",
        "description": "Cached geocoding and timezone lookups for BMLT-enabled applications. Every endpoint requires an API key (Settings → API Keys) sent as a Bearer token.",
        "contact": {
            "email": "admin@bmlt.app"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://geo.aws.bmlt.app",
            "description": "Production"
        }
    ],
    "paths": {
        "/api/geocode": {
            "get": {
                "tags": [
                    "Geocoding"
                ],
                "summary": "Geocode an address or place",
                "description": "Returns the Google Maps Geocoding response (served from the shared cache when available) plus `type` (\"cache\" or \"live\") and a `request` echo.",
                "operationId": "geocode",
                "parameters": [
                    {
                        "name": "application",
                        "in": "query",
                        "description": "Your application identifier (used for analytics).",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Address or place to geocode.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "referrer",
                        "in": "query",
                        "description": "URL of the requesting page (region detection + analytics).",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    {
                        "name": "language",
                        "in": "query",
                        "description": "BCP-47 language code (default: en).",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "region",
                        "in": "query",
                        "description": "Region bias as a ccTLD (e.g. \"fr\", \"ca\"). Overrides the region inferred from the referrer domain — useful when the referrer has no country TLD.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "north",
                        "in": "query",
                        "description": "Viewport north bound (decimal degrees).",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "south",
                        "in": "query",
                        "description": "Viewport south bound (decimal degrees).",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "east",
                        "in": "query",
                        "description": "Viewport east bound (decimal degrees).",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "west",
                        "in": "query",
                        "description": "Viewport west bound (decimal degrees).",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Geocoding result (cache or live). The body is the Google Maps Geocoding response verbatim, with `type` and `request` added by this service. `results` is an empty array when `status` is `ZERO_RESULTS`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "results",
                                        "status",
                                        "type",
                                        "request"
                                    ],
                                    "properties": {
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "formatted_address": {
                                                        "type": "string",
                                                        "example": "New York, NY, USA"
                                                    },
                                                    "place_id": {
                                                        "type": "string",
                                                        "example": "ChIJOwg_06VPwokRYv534QaPC8g"
                                                    },
                                                    "types": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        },
                                                        "example": [
                                                            "locality",
                                                            "political"
                                                        ]
                                                    },
                                                    "address_components": {
                                                        "type": "array",
                                                        "items": {
                                                            "properties": {
                                                                "long_name": {
                                                                    "type": "string"
                                                                },
                                                                "short_name": {
                                                                    "type": "string"
                                                                },
                                                                "types": {
                                                                    "type": "array",
                                                                    "items": {
                                                                        "type": "string"
                                                                    }
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "geometry": {
                                                        "properties": {
                                                            "location": {
                                                                "description": "Coordinates of the result. Read via results[0].geometry.location.",
                                                                "properties": {
                                                                    "lat": {
                                                                        "type": "number",
                                                                        "format": "float",
                                                                        "example": 40.7127753
                                                                    },
                                                                    "lng": {
                                                                        "type": "number",
                                                                        "format": "float",
                                                                        "example": -74.0059728
                                                                    }
                                                                },
                                                                "type": "object"
                                                            },
                                                            "location_type": {
                                                                "type": "string",
                                                                "example": "APPROXIMATE"
                                                            },
                                                            "viewport": {
                                                                "properties": {
                                                                    "northeast": {
                                                                        "properties": {
                                                                            "lat": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            },
                                                                            "lng": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            }
                                                                        },
                                                                        "type": "object"
                                                                    },
                                                                    "southwest": {
                                                                        "properties": {
                                                                            "lat": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            },
                                                                            "lng": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            }
                                                                        },
                                                                        "type": "object"
                                                                    }
                                                                },
                                                                "type": "object"
                                                            },
                                                            "bounds": {
                                                                "description": "Present only for results that cover an area.",
                                                                "properties": {
                                                                    "northeast": {
                                                                        "properties": {
                                                                            "lat": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            },
                                                                            "lng": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            }
                                                                        },
                                                                        "type": "object"
                                                                    },
                                                                    "southwest": {
                                                                        "properties": {
                                                                            "lat": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            },
                                                                            "lng": {
                                                                                "type": "number",
                                                                                "format": "float"
                                                                            }
                                                                        },
                                                                        "type": "object"
                                                                    }
                                                                },
                                                                "type": "object"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "status": {
                                            "description": "Google geocoding status.",
                                            "type": "string",
                                            "example": "OK",
                                            "enum": [
                                                "OK",
                                                "ZERO_RESULTS"
                                            ]
                                        },
                                        "type": {
                                            "description": "Added by this service: whether the response came from the shared cache or a live Google call.",
                                            "type": "string",
                                            "example": "cache",
                                            "enum": [
                                                "cache",
                                                "live"
                                            ]
                                        },
                                        "request": {
                                            "description": "Added by this service: an echo of the resolved request parameters.",
                                            "properties": {
                                                "search": {
                                                    "type": "string",
                                                    "example": "New York, NY"
                                                },
                                                "application": {
                                                    "type": "string",
                                                    "example": "my-app"
                                                },
                                                "language": {
                                                    "type": "string",
                                                    "example": "en"
                                                },
                                                "referrer": {
                                                    "type": "string",
                                                    "example": "https://example.com"
                                                },
                                                "region": {
                                                    "type": "string",
                                                    "example": null,
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key."
                    },
                    "403": {
                        "description": "Account not yet approved."
                    },
                    "422": {
                        "description": "Validation error (missing required parameters)."
                    },
                    "429": {
                        "description": "Rate limit exceeded — see Retry-After header."
                    },
                    "502": {
                        "description": "Upstream geocoding service returned an invalid or error response."
                    },
                    "503": {
                        "description": "Upstream geocoding quota exceeded — see Retry-After header."
                    },
                    "504": {
                        "description": "Upstream geocoding service did not respond in time."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/timezone": {
            "get": {
                "tags": [
                    "Timezone"
                ],
                "summary": "Look up the timezone for a location",
                "description": "Provide either `address` (geocoded first) or `location` as \"latitude,longitude\" — the two are mutually exclusive. Returns dstOffset, rawOffset, timeZoneId and timeZoneName.",
                "operationId": "timezone",
                "parameters": [
                    {
                        "name": "address",
                        "in": "query",
                        "description": "Address to geocode and look up. Mutually exclusive with location.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "location",
                        "in": "query",
                        "description": "Comma-separated latitude,longitude (e.g. 39.60,-119.68). Mutually exclusive with address.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Timezone result (dstOffset, rawOffset, timeZoneId, timeZoneName)."
                    },
                    "401": {
                        "description": "Missing or invalid API key."
                    },
                    "403": {
                        "description": "Account not yet approved."
                    },
                    "422": {
                        "description": "Validation error (both/neither parameter, bad location format, or no timezone data for the location)."
                    },
                    "502": {
                        "description": "Upstream Google Timezone/Geocoding service returned an invalid or error response."
                    },
                    "503": {
                        "description": "Upstream quota exceeded — see Retry-After header."
                    },
                    "504": {
                        "description": "Upstream service did not respond in time."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "API key from Settings → API Keys. Send as: Authorization: Bearer geo_...",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Geocoding",
            "description": "Geocoding"
        },
        {
            "name": "Timezone",
            "description": "Timezone"
        }
    ]
}